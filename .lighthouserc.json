{
  "ci": {
    "collect": {
      "numberOfRuns": 3
    },
    "assert": {
      "//": "Asserted on the median of the 3 runs collected above, not the best. LHCI's default aggregation is optimistic, which would let one lucky pass hide a real regression.",
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.90 }],
        "categories:accessibility": ["error", { "minScore": 0.90 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
